# ===================== 涉农信贷风控系统 环境配置 =====================

# ---------- 应用 ----------
APP_NAME=涉农信贷风险智能评估系统
APP_VERSION=1.2.0
API_PREFIX=/api/v1

# ---------- 数据库（MySQL）----------
# 本机 / 生产均使用 MySQL 8.0
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/race?charset=utf8mb4

# ---------- JWT 认证 ----------
# ⚠️ 生产环境务必更换为随机长字符串，可用以下命令生成：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=race-dev-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- CORS（逗号分隔多个来源，* 表示全部）----------
# 生产环境建议显式列出允许来源（如 Cloudflare Pages 域名），不要使用 *
CORS_ORIGINS=*

# ---------- 默认管理员（首次启动自动创建）----------
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ---------- 模型训练 ----------
# 启动时若无已训练模型，自动用合成样本训练
AUTO_TRAIN_ON_STARTUP=true
SEED_SAMPLES=3000
SEED_DEFAULT_RATE=0.04

# ---------- 评分卡业务阈值（管理平台可在线调整）----------
LOW_RISK_THRESHOLD=700
HIGH_RISK_THRESHOLD=500
BASE_RATE=3.5
RISK_PREMIUM_FACTOR=6.0

# ---------- API 调用日志 ----------
API_LOG_RETENTION_DAYS=30

# ---------- 可选 AI 复核（密钥仅配置在后端，不要提交真实密钥） ----------
AI_REVIEW_ENABLED=false
AI_REVIEW_NAMESPACE=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# 可选；DeepSeek 简短复核可设 none，空值表示不发送该参数
# OPENAI_REASONING_EFFORT=none
AI_REVIEW_CONCURRENCY=2
AI_REVIEW_IDLE_TIMEOUT=30
AI_REVIEW_TOTAL_TIMEOUT=90
AI_REVIEW_LEASE_SECONDS=120
AI_REVIEW_RETRY_COOLDOWN=60
AI_REVIEW_MAX_OUTPUT_TOKENS=2048
